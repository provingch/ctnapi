# /etc/ctnapi/ctnapi.env   (chmod 640, dueño root:ctnapi)
# IP privada del contenedor ctnapi, accesible desde nginx y los servicios autorizados.
SERVER_ADDRESS=192.168.100.XX
CTN_DB_HOST=ctnapi-db:3306
CTN_DB_NAME=ctnapi_db
CTN_DB_USER=ctnapi_app
CTN_DB_PASSWORD=CAMBIAR_CLAVE_APP

# Clave para llamadas internas de SCA/servicios (generar con: openssl rand -base64 48)
CORE_API_KEY=CAMBIAR_CLAVE_SERVICIO

# Mínimo 32 caracteres, distinto del JWT_SECRET de SCA:  openssl rand -base64 48
CTNAPI_JWT_SECRET=CAMBIAR
# Claves fijas (X-API-Key). Si se dejan vacías, esa API responde 503. Usar las MISMAS que hoy tienen los clientes
# mientras dure la transición, así solo cambia la URL.
ANOTACIONES_API_KEY=
ENFERMERIA_API_KEY=
