# /etc/ctnapi/backup.env   (chmod 640, dueño root:ctnapi)
BACKUP_DIR=/var/backups/ctnapi
RETENTION_DAYS=14        # cuántos días se conservan las copias
CTN_DB_HOST=192.168.100.XX   # host de MySQL/MariaDB (el mismo de ctnapi.env)
CTN_DB_NAME=ctndb
BACKUP_SCOPE=own         # own = solo tablas de ctnapi | all = toda la base
